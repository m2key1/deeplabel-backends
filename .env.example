# The tags ./build.sh printed, one per backend this machine serves.
DEEPOCR_TAG=
KRAKEN_TAG=
# Each backend's secret; DeepLabel's MODEL_BACKEND_<NAME>_SECRET must be the same string.
DEEPOCR_SECRET=
KRAKEN_SECRET=
# Host ports, which DeepLabel's MODEL_BACKEND_<NAME>_URL points at.
DEEPOCR_PORT=9201
KRAKEN_PORT=9205
